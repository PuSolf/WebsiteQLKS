@model RegisterViewModel
@{ ViewData["Title"] = "Tạo tài khoản"; }
<section class="auth-page container-wide"><div class="auth-art"><div class="auth-art-mark">S</div><p class="eyebrow">YOUR NEXT CHAPTER</p><h1>Bắt đầu bằng<br />một kỳ nghỉ đẹp.</h1><p>Tạo tài khoản Sunrise để lưu giữ và theo dõi những đặt phòng của bạn.</p></div><div class="auth-card"><a asp-controller="Home" asp-action="Index" class="back-link">← Về trang chủ</a><h2>Tạo tài khoản</h2><p class="muted">Chỉ một phút để bắt đầu.</p><div asp-validation-summary="ModelOnly" class="validation-summary"></div>
<form asp-action="Register" method="post" class="stack-form"><label>Họ và tên<input asp-for="HoTen" autocomplete="name" placeholder="Nguyễn Văn An" /></label><span asp-validation-for="HoTen" class="field-error"></span><label>Email<input asp-for="Email" autocomplete="email" placeholder="ban@email.com" /></label><span asp-validation-for="Email" class="field-error"></span><label>Số điện thoại<input asp-for="SoDienThoai" autocomplete="tel" placeholder="09xx xxx xxx" /></label><span asp-validation-for="SoDienThoai" class="field-error"></span><label>Tên đăng nhập<input asp-for="Username" autocomplete="username" placeholder="Tên đăng nhập" /></label><span asp-validation-for="Username" class="field-error"></span><label>Mật khẩu<input asp-for="Password" autocomplete="new-password" placeholder="Ít nhất 8 ký tự" /></label><span asp-validation-for="Password" class="field-error"></span><label>Xác nhận mật khẩu<input asp-for="ConfirmPassword" autocomplete="new-password" placeholder="Nhập lại mật khẩu" /></label><span asp-validation-for="ConfirmPassword" class="field-error"></span><button type="submit" class="button button-dark button-full">Tạo tài khoản <span>↗</span></button></form><p class="auth-switch">Đã có tài khoản? <a asp-action="Login">Đăng nhập</a></p></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
