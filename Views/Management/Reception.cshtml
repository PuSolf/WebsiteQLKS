@{ ViewData["Title"] = "Bàn làm việc lễ tân"; }
<section class="page-hero management-hero"><div class="container-wide"><div class="eyebrow eyebrow-muted"><span class="eyebrow-line"></span> FRONT DESK</div><h1>Bàn làm việc <em>lễ tân.</em></h1><p>Xác nhận booking, hỗ trợ check-in/check-out và ghi nhận thanh toán.</p></div></section>
<section class="container-wide section manager-page"><div class="panel-head"><div><h2>Danh sách booking</h2><p>Các hành động được lưu trực tiếp vào SQL Server.</p></div><div class="panel-filters"><input id="bookingQuery" type="search" placeholder="Mã booking, tên, số phòng"/><select id="bookingStatus"><option value="All">Tất cả trạng thái</option><option>Pending</option><option>Confirmed</option><option>CheckedIn</option><option>CheckedOut</option><option>Cancelled</option></select><button class="button button-dark button-small" id="refreshBookings">Lọc</button></div></div><div class="table-wrap"><table class="data-table"><thead><tr><th>Booking</th><th>Khách hàng</th><th>Phòng</th><th>Ngày</th><th>Tổng tiền</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody id="managerBookings"><tr><td colspan="7">Đang tải...</td></tr></tbody></table></div>
<div class="report-box reception-booking-box"><h3>Tạo booking tại quầy</h3><p class="muted">Tìm khách và phòng trống theo ngày trước khi gửi yêu cầu.</p><form id="receptionBookingForm" class="inline-editor reception-booking-form"><label>Tìm khách hàng<input id="staffCustomerQuery" type="search" placeholder="Tên / điện thoại / email"/></label><label>Khách hàng<select id="staffCustomerId" required><option value="">Chọn khách hàng</option></select></label><label>Ngày nhận<input id="staffCheckIn" type="date" required/></label><label>Ngày trả<input id="staffCheckOut" type="date" required/></label><label>Số khách<select id="staffGuests"><option>1</option><option selected>2</option><option>3</option><option>4</option></select></label><label>Phòng trống<select id="staffRoomId" required><option value="">Chọn ngày trước</option></select></label><div class="editor-actions"><button class="button button-dark button-small" type="submit">Tạo booking Pending</button></div></form></div>
<div class="frontdesk-lower"><div class="report-box"><h3>Ghi nhận thanh toán / đặt cọc</h3><form id="paymentForm" class="stack-form compact-form"><label>Mã booking<input id="paymentBookingId" type="number" required min="1"/></label><label>Mã hóa đơn (nếu thanh toán hóa đơn)<input id="paymentInvoiceId" type="number" min="1"/></label><label>Số tiền (VND)<input id="paymentAmount" type="number" required min="1" step="1000"/></label><label>Phương thức<select id="paymentMethod"><option value="Cash">Tiền mặt</option><option value="BankTransfer">Chuyển khoản</option><option value="Card">Thẻ</option></select></label><button class="button button-dark" type="submit">Ghi nhận thanh toán</button></form></div><div class="report-box"><h3>Tra cứu khách hàng</h3><form id="customerSearchForm" class="inline-search"><input id="customerQuery" type="search" placeholder="Tên, điện thoại hoặc email"/><button class="button button-dark button-small" type="submit">Tìm</button></form><div class="table-wrap"><table class="data-table"><thead><tr><th>Khách</th><th>Điện thoại</th><th>Email</th></tr></thead><tbody id="receptionCustomers"><tr><td colspan="3">Nhập từ khóa để tìm.</td></tr></tbody></table></div></div></div>
</section>
@section Scripts { <script src="~/js/management.js" asp-append-version="true"></script> }
