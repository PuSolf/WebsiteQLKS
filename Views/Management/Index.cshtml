@{ ViewData["Title"] = "Trung tâm quản trị"; }
<section class="page-hero management-hero"><div class="container-wide"><div class="eyebrow eyebrow-muted"><span class="eyebrow-line"></span> MANAGEMENT CONSOLE</div><h1>Vận hành <em>khách sạn.</em></h1><p>Tổng quan vận hành và các thao tác quản lý được cập nhật trực tiếp.</p></div></section>
<section class="container-wide section manager-page">
    <div id="managerStats" class="stats-grid"><div class="stat-card skeleton"></div><div class="stat-card skeleton"></div><div class="stat-card skeleton"></div><div class="stat-card skeleton"></div><div class="stat-card skeleton"></div></div>
    <div class="tabs" role="tablist"><button class="tab active" data-tab="bookings">Đặt phòng</button><button class="tab" data-tab="rooms">Phòng</button><button class="tab" data-tab="room-types">Hạng phòng</button><button class="tab" data-tab="payments">Thanh toán</button><button class="tab" data-tab="reports">Báo cáo</button><button class="tab" data-tab="customers">Khách hàng</button><button class="tab" data-tab="employees">Nhân viên</button><button class="tab" data-tab="hotel">Khách sạn</button><a class="tab "href="/swagger" class="nav-link nav-api" target="_blank" rel="noopener">API</a></div>
    <section class="manager-panel active" id="panel-bookings"><div class="panel-head"><div><h2>Danh sách booking</h2><p>Quản lý trạng thái lưu trú của khách.</p></div><div class="panel-filters"><input id="bookingQuery" type="search" placeholder="Mã booking, tên, số phòng"/><select id="bookingStatus"><option value="All">Tất cả trạng thái</option><option>Pending</option><option>Confirmed</option><option>CheckedIn</option><option>CheckedOut</option><option>Cancelled</option></select><button class="button button-dark button-small" id="refreshBookings">Lọc</button></div></div><div class="table-wrap"><table class="data-table"><thead><tr><th>Booking</th><th>Khách hàng</th><th>Phòng</th><th>Thời gian</th><th>Tổng tiền</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody id="managerBookings"><tr><td colspan="7">Đang tải...</td></tr></tbody></table></div></section>
    <section class="manager-panel" id="panel-rooms"><div class="panel-head"><div><h2>Quản lý phòng</h2><p>Thêm, sửa và cập nhật trạng thái phòng.</p></div><button class="button button-dark button-small" id="newRoomButton">+ Thêm phòng</button></div><form id="roomEditor" class="inline-editor" hidden><input type="hidden" id="editRoomId"/><label>Số phòng<input id="editRoomNumber" maxlength="10" required/></label><label>Tầng<input id="editRoomFloor" type="number" min="0" max="100" value="1" required/></label><label>Loại phòng<select id="editRoomType" required></select></label><label>Trạng thái<select id="editRoomStatus"><option>Available</option><option>Reserved</option><option>Occupied</option><option>Maintenance</option><option>NeedsCleaning</option></select></label><label>Ảnh hiện tại (đường dẫn /img/)<input id="editRoomImage" placeholder="/img/room-deluxe.svg" maxlength="260"/></label><label class="editor-wide">Tải ảnh mới (JPG, PNG, WebP · tối đa 3 MB)<input id="editRoomImageFile" type="file" accept="image/jpeg,image/png,image/webp"/></label><div class="editor-actions"><button type="submit" class="button button-dark button-small">Lưu phòng</button><button type="button" class="button button-outline button-small" id="cancelRoomEdit">Đóng</button></div></form><div class="table-wrap"><table class="data-table"><thead><tr><th>Số phòng</th><th>Tầng</th><th>Hạng phòng</th><th>Giá/đêm</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody id="managerRooms"><tr><td colspan="6">Đang tải...</td></tr></tbody></table></div></section>
    <section class="manager-panel" id="panel-room-types"><div class="panel-head"><div><h2>Quản lý hạng phòng</h2><p>Điều chỉnh giá niêm yết, sức chứa và tiện nghi.</p></div><button class="button button-dark button-small" id="newRoomTypeButton">+ Thêm hạng phòng</button></div><form id="roomTypeEditor" class="inline-editor" hidden><input type="hidden" id="editRoomTypeId"/><label>Tên hạng phòng<input id="editRoomTypeName" required maxlength="50"/></label><label>Giá / đêm (VND)<input id="editRoomTypePrice" type="number" min="0" required step="1000"/></label><label>Sức chứa<input id="editRoomTypeGuests" type="number" min="1" max="20" value="2" required/></label><label class="editor-wide">Tiện nghi<input id="editRoomTypeAmenities" maxlength="500" placeholder="Wi-Fi, TV, Điều hòa..."/></label><div class="editor-actions"><button class="button button-dark button-small" type="submit">Lưu hạng phòng</button><button type="button" class="button button-outline button-small" id="cancelRoomTypeEdit">Đóng</button></div></form><div class="table-wrap"><table class="data-table"><thead><tr><th>Hạng phòng</th><th>Giá / đêm</th><th>Sức chứa</th><th>Tiện nghi</th><th>Thao tác</th></tr></thead><tbody id="managerRoomTypes"><tr><td colspan="5">Đang tải...</td></tr></tbody></table></div></section>
    <section class="manager-panel" id="panel-payments"><div class="panel-head"><div><h2>Thanh toán</h2><p>Tra cứu giao dịch và ghi nhận hoàn tiền.</p></div><button class="button button-dark button-small" id="refreshPayments">Làm mới</button></div><div class="table-wrap"><table class="data-table"><thead><tr><th>Mã giao dịch</th><th>Booking</th><th>Khách hàng</th><th>Số tiền</th><th>Phương thức</th><th>Thời gian</th><th>Trạng thái</th><th></th></tr></thead><tbody id="managerPayments"><tr><td colspan="8">Đang tải...</td></tr></tbody></table></div></section>
    <section class="manager-panel" id="panel-reports"><div class="panel-head"><div><h2>Báo cáo vận hành</h2><p>Doanh thu theo ngày và tổng quan booking dựa trên database views.</p></div><button class="button button-dark button-small" id="refreshReports">Tải báo cáo</button></div><div class="report-grid"><div class="report-box"><h3>Doanh thu gần đây</h3><div id="revenueReport"></div></div><div class="report-box"><h3>Booking gần đây</h3><div id="bookingReport"></div></div></div></section>
    <section class="manager-panel" id="panel-customers"><div class="panel-head"><div><h2>Khách hàng</h2><p>Tìm và xem hồ sơ khách hàng.</p></div><div class="panel-filters"><input id="customerQuery" type="search" placeholder="Tên, điện thoại hoặc email"/><button class="button button-dark button-small" id="searchCustomers">Tìm kiếm</button></div></div><div class="table-wrap"><table class="data-table"><thead><tr><th>Mã</th><th>Họ tên</th><th>Điện thoại</th><th>Email</th><th>Số giấy tờ</th><th>Thao tác</th></tr></thead><tbody id="managerCustomers"><tr><td colspan="5">Chọn tab để tải dữ liệu.</td></tr></tbody></table></div><form class="inline-editor" id="newCustomerForm"><label>Họ tên<input id="newCustomerName" required maxlength="100"/></label><label>Số điện thoại<input id="newCustomerPhone" required maxlength="20"/></label><label>Email<input id="newCustomerEmail" type="email" maxlength="100"/></label><label>Số giấy tờ<input id="newCustomerIdNumber" maxlength="20"/></label><button class="button button-dark button-small" type="submit">Thêm khách</button></form></section>
    <section class="manager-panel" id="panel-employees"><div class="panel-head"><div><h2>Nhân viên</h2><p>Quản lý tài khoản lễ tân.</p></div><button class="button button-dark button-small" id="refreshEmployees">Làm mới</button></div><div class="table-wrap"><table class="data-table"><thead><tr><th>Mã</th><th>Họ tên</th><th>Chức vụ</th><th>Tài khoản</th><th>Email</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody id="managerEmployees"><tr><td colspan="6">Chọn tab để tải dữ liệu.</td></tr></tbody></table></div><form class="inline-editor" id="newEmployeeForm"><label>Họ tên<input id="newEmployeeName" required maxlength="100"/></label><label>Điện thoại<input id="newEmployeePhone" maxlength="20"/></label><label>Tên đăng nhập<input id="newEmployeeUsername" required minlength="4" maxlength="50"/></label><label>Email<input id="newEmployeeEmail" required type="email" maxlength="100"/></label><label>Mật khẩu tạm<input id="newEmployeePassword" required type="password" minlength="8" maxlength="100"/></label><button class="button button-dark button-small" type="submit">Tạo lễ tân</button></form></section>
    <section class="manager-panel" id="panel-hotel"><div class="panel-head"><div><h2>Thông tin khách sạn</h2><p>Thông tin cơ sở được hiển thị trên website.</p></div></div><form id="hotelInfoForm" class="profile-form"><div class="form-grid"><label>Tên khách sạn<input id="hotelName" required maxlength="150"/></label><label>Điện thoại<input id="hotelPhone" required maxlength="20"/></label><label>Địa chỉ<input id="hotelAddress" required maxlength="250"/></label><label>Email<input id="hotelEmail" type="email" maxlength="100"/></label><label>Giờ nhận phòng<input id="hotelCheckin" type="time" required/></label><label>Giờ trả phòng<input id="hotelCheckout" type="time" required/></label><input id="hotelId" type="hidden"/></div><button type="submit" class="button button-dark">Lưu thông tin ↗</button></form></section>
</section>
@section Scripts { <script src="~/js/management.js" asp-append-version="true"></script> }
